# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Site Configuration (for production deployment)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Server-only founder/admin authorization
ADMIN_EMAIL=founder@example.com

# Server-only Supabase key for admin operations and trusted notifications
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Optional: Add other environment variables here as needed
# NODE_ENV=production

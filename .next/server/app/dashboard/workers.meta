{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/dashboard/layout,_N_T_/dashboard/workers/layout,_N_T_/dashboard/workers/page,_N_T_/dashboard/workers"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/dashboard/workers/__PAGE__",
    "/dashboard/workers",
    "/dashboard",
    "/_index",
    "/_head"
  ]
}